{
  "manifest_version": 3,
  "name": "PageSurgeon",
  "version": "0.2.0",
  "description": "Surgically edit, delete, blur, and screenshot any element on a webpage",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
        "js": [
          "scripts/utils/dom-utils.js",
          "scripts/modes/delete-mode.js",
          "scripts/modes/edit-mode.js",
          "scripts/modes/screenshot-mode.js",
          "scripts/modes/blur-mode.js",
          "scripts/content.js"
        ],
      "css": ["styles/panel.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PageSurgeon"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
